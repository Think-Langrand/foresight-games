# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editor-local settings — personal, not the project's
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the committed template so setup docs can point at it.
!.env.example

# vercel
.vercel

# supabase
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# test artifacts
.playwright-mcp/
/*.png

# browser automation scratch — a headless Chrome profile is generated here by test runs
# and must never be committed (it carries machine identifiers and caches)
/chrome-profile/
/*-profile/

# Answer exports pulled from the admin viewer. The committed fixtures live in docs/data/ —
# that path is the deliberate exception and stays tracked. Anywhere else these are a dump
# that happens to be sitting in the repo, and data/ is one `git add .` from taking a
# megabyte of them along with a real change.
/data/week*/
