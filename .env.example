# Supabase — the app's datastore: live workshop state (sessions, teams,
# submissions, responses) AND game content (deck, drivers, nested model).
# URL + anon/publishable key are public (sent to the browser for realtime) and
# are inlined into the client bundle at BUILD time — set them before building.
# The service_role key is server-only; never expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=XXXXXXXXXXXXXXXXXXXXXXXX

# Site gate — OPTIONAL. Password for the app-wide unlock screen (SiteGate).
# Public / inlined into the client bundle at BUILD time, so this is a soft gate,
# not real security. Defaults to the launch password if unset.
# NEXT_PUBLIC_SITE_PASSWORD=publicHealth35
#
# Turn the gate OFF entirely by setting this to false/0/off (also inlined at
# BUILD time). Unset — or any other value — keeps the gate ON, so the default
# stays locked. Use this to open the site publicly without removing the code.
# NEXT_PUBLIC_SITE_GATE_ENABLED=false

# OpenAI — OPTIONAL. Powers the "Suggest tags" button in the Analysis view
# (POST /api/analysis/suggest-tags), which uses GPT-5. Without it, tagging still
# works manually; only the LLM suggestion is disabled.
# OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXX

# Airtable — OPTIONAL / legacy. No longer used at runtime (content lives in
# Supabase). Only needed if you re-run the scripts/ content-import helpers.
# AIRTABLE_TOKEN=pat_XXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# AIRTABLE_BASE_ID=appJbrDG28mXRJgfA

# Foresight platform API — OPTIONAL. Powers the /scenario-sets pages, which pull
# a project's published scenarios from the external foresight platform (read-only,
# server-to-server; the key is server-only and never reaches the browser). Without
# it, those pages show a "not configured" notice; the rest of the app is unaffected.
# Base URL should include the /api/v1/foresight path (the legacy FORESIGHT_URL —
# bare host — is also accepted and the path is appended automatically).
# FORESIGHT_API_URL=http://localhost:8000/api/v1/foresight
# FORESIGHT_API_KEY=XXXXXXXXXXXXXXXX
# Which project's scenarios to show. Defaults to nnphi; this is the seam for
# later multi-tenant / per-client use.
# FORESIGHT_PROJECT_REF=nnphi
